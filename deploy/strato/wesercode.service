[Unit]
Description=WeserCode Next.js application
After=network.target

[Service]
Type=simple
User=wesercode
Group=wesercode
WorkingDirectory=/var/www/wesercode/.next/standalone
EnvironmentFile=/var/www/wesercode/.env.production
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
